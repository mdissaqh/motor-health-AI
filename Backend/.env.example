PORT=5000

# Hugging Face AI Configuration (Serverless Inference Providers API)
# Get a free Hugging Face User Access Token from https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# Recommended open-weights instruction-tuned models on Hugging Face router
# e.g. meta-llama/Llama-3.2-3B-Instruct, Qwen/Qwen2.5-7B-Instruct, mistralai/Mistral-7B-Instruct-v0.3
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
